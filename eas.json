{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "env": {
          "GOOGLE_SERVICES_JSON": "@GOOGLE_SERVICES_JSON",
          "GOOGLE_WEB_CLIENT_ID": "@GOOGLE_WEB_CLIENT_ID",
          "GOOGLE_ANDROID_CLIENT_ID": "@GOOGLE_ANDROID_CLIENT_ID"
        }
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "env": {
          "GOOGLE_SERVICES_JSON": "@GOOGLE_SERVICES_JSON",
          "GOOGLE_WEB_CLIENT_ID": "@GOOGLE_WEB_CLIENT_ID",
          "GOOGLE_ANDROID_CLIENT_ID": "@GOOGLE_ANDROID_CLIENT_ID"
        }
      }
    }
  },
  "submit": {
    "production": {}
  }
}
